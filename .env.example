# GameCube-Manager Configuration
PORT=3000
HOST=0.0.0.0
JWT_SECRET=gamecube-super-secret-key-change-in-production

# Host filesystem mount in container
HOST_ROOT=/host_root

# Steam userdata directory path on host
STEAM_USERDATA_PATH=/host_root/home/deck/.local/share/Steam/userdata

# qBittorrent Web UI connection (internal container port)
QBITTORRENT_URL=http://127.0.0.1:8085
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# SteamGridDB API Key (https://www.steamgriddb.com/profile/preferences/api)
STEAMGRIDDB_API_KEY=
